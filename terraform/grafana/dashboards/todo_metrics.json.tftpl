{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "${datasource_name}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "req/s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "max",
            "mean",
            "min"
          ],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "sort": "none",
          "timeStatic": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_duration_seconds_count{path!=\"/metrics\", path!=\"/health\"}[1m])) by (method, path)",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "title": "Taxa de Requisições HTTP (Rate)",
      "type": "timeseries"
    },
    {
      "datasource": "${datasource_name}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "max",
            "mean",
            "min"
          ],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "sort": "none",
          "timeStatic": false
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(flask_http_request_duration_seconds_bucket{path!=\"/metrics\", path!=\"/health\"}[5m])) by (le, method, path))",
          "legendFormat": "{{method}} {{path}} - 95th Percentile",
          "refId": "A"
        }
      ],
      "title": "Latência (95º Percentil)",
      "type": "timeseries"
    },
    {
      "datasource": "${datasource_name}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "max",
            "current"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "sort": "none",
          "timeStatic": false
        }
      },
      "targets": [
        {
          "expr": "sum(flask_http_request_duration_seconds_count{path!=\"/metrics\", path!=\"/health\"}) by (method, path, status)",
          "legendFormat": "{{method}} {{path}} ({{status}})",
          "refId": "A"
        }
      ],
      "title": "Contagem Total de Requisições (Por Rota e Status)",
      "type": "table"
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "flask",
    "api",
    "prometheus",
    "todo",
    "${environment}" 
  ],
  "templating": {
    "list": [
      {
        "allValue": null,
        "current": {
          "selected": true,
          "text": "${datasource_name}",
          "value": "${datasource_name}"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "description": "Fonte de dados Prometheus",
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "ToDo- Tarefas Chronyka (${environment} Environment)",
  "uid": "flask-todo-api-${environment}",
  "version": 1
}